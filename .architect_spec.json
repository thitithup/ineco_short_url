{
  "project_name": "short-url-generator",
  "tech_stack": {
    "language": "Python 3.11+",
    "framework": "FastAPI",
    "orm_or_db_driver": "SQLAlchemy 2.0+",
    "database": "SQLite (file-based or in-memory for testing)"
  },
  "architecture_summary": "A high-performance URL shortening and analytics REST service using FastAPI, SQLAlchemy 2.0 with asynchronous/synchronous SQLite support, Pydantic v2 schemas, and API Key authentication.",
  "directory_structure": [
    "short/src/config.py",
    "short/src/database.py",
    "short/src/models.py",
    "short/src/schemas.py",
    "short/src/crud.py",
    "short/src/auth.py",
    "short/src/main.py",
    "short/tests/test_api.py",
    "short/docs/"
  ],
  "env_variables": [
    { "key": "DATABASE_URL", "description": "SQLite database connection URI", "example": "sqlite:///./short_url.db", "required": true },
    { "key": "API_KEY", "description": "Secret key for administrative and creation endpoints", "example": "ineco-secret-key-12345", "required": true },
    { "key": "BASE_URL", "description": "Base URL for generating shortened URLs", "example": "http://localhost:8000", "required": true }
  ],
  "auth_scheme": {
    "type": "APIKeyHeader",
    "header": "X-API-Key",
    "roles": ["ADMIN", "AUTHORIZED_CLIENT"]
  },
  "standard_error_response": {
    "status": "error",
    "error_code": "STRING_IDENTIFIER",
    "message": "Human readable error message",
    "details": {}
  },
  "entities": [
    {
      "name": "URLItem",
      "table_name": "urls",
      "fields": [
        { "name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY, AUTOINCREMENT" },
        { "name": "original_url", "type": "TEXT", "constraints": "NOT NULL" },
        { "name": "short_code", "type": "VARCHAR(10)", "constraints": "UNIQUE, INDEX, NOT NULL" },
        { "name": "click_count", "type": "INTEGER", "constraints": "DEFAULT 0, NOT NULL" },
        { "name": "expires_at", "type": "DATETIME", "constraints": "NULLABLE" },
        { "name": "created_at", "type": "DATETIME", "constraints": "DEFAULT CURRENT_TIMESTAMP, NOT NULL" }
      ],
      "relations": [
        { "type": "hasMany", "target": "ClickLog", "foreign_key": "url_id" }
      ]
    },
    {
      "name": "ClickLog",
      "table_name": "click_logs",
      "fields": [
        { "name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY, AUTOINCREMENT" },
        { "name": "url_id", "type": "INTEGER", "constraints": "FOREIGN KEY (urls.id), NOT NULL, INDEX" },
        { "name": "clicked_at", "type": "DATETIME", "constraints": "DEFAULT CURRENT_TIMESTAMP, NOT NULL" },
        { "name": "user_agent", "type": "TEXT", "constraints": "NULLABLE" },
        { "name": "referrer", "type": "TEXT", "constraints": "NULLABLE" }
      ]
    }
  ],
  "api_contracts": [
    {
      "name": "Shorten URL",
      "method": "POST",
      "path": "/api/v1/shorten",
      "auth_required": true,
      "request_body": {
        "original_url": "https://example.com/very/long/url",
        "expires_in_hours": 24
      },
      "response_body": {
        "short_code": "aB3d9Z",
        "short_url": "http://localhost:8000/aB3d9Z",
        "original_url": "https://example.com/very/long/url",
        "expires_at": "2026-09-11T09:00:00Z",
        "created_at": "2026-09-10T09:00:00Z"
      },
      "status_code": 201
    },
    {
      "name": "Redirect Short URL",
      "method": "GET",
      "path": "/{short_code}",
      "auth_required": false,
      "response_body": {},
      "status_code": 307
    },
    {
      "name": "Get URL Analytics",
      "method": "GET",
      "path": "/api/v1/analytics/{short_code}",
      "auth_required": true,
      "response_body": {
        "short_code": "aB3d9Z",
        "original_url": "https://example.com/very/long/url",
        "total_clicks": 42,
        "is_expired": false,
        "expires_at": "2026-09-11T09:00:00Z",
        "recent_clicks": [
          { "clicked_at": "2026-09-10T09:15:00Z", "user_agent": "Mozilla/5.0..." }
        ]
      },
      "status_code": 200
    },
    {
      "name": "Healthcheck",
      "method": "GET",
      "path": "/health",
      "auth_required": false,
      "response_body": { "status": "ok" },
      "status_code": 200
    }
  ],
  "business_rules": [
    "Short code must be alphanumeric (base62) and exactly 6 characters.",
    "If generated code already exists, regenerate with max 5 attempts.",
    "If URL is expired, redirect must return HTTP 410 Gone with standard error response.",
    "Click count must be incremented atomically upon successful redirection.",
    "Creation and analytics endpoints must require valid X-API-Key header.",
    "MCP tools must communicate via Standard I/O (stdio) transport using FastMCP.",
    "MCP resolve_url tool must not increment click count or write to click_logs."
  ],
  "mcp_specification": {
    "server_name": "ineco-short-url-mcp",
    "transport": "stdio",
    "tools": [
      {
        "name": "shorten_url",
        "description": "Shorten a target long URL and optionally specify expiration time in hours",
        "parameters": {
          "url": { "type": "string", "description": "The original target URL to shorten", "required": true },
          "expires_in_hours": { "type": "integer", "description": "Optional lifetime in hours", "required": false }
        },
        "returns": {
          "short_code": "string",
          "short_url": "string",
          "original_url": "string",
          "expires_at": "string or null"
        }
      },
      {
        "name": "get_url_analytics",
        "description": "Retrieve click counts, creation date, expiration status, and recent click logs for a short URL",
        "parameters": {
          "short_code": { "type": "string", "description": "6-character short code", "required": true }
        },
        "returns": {
          "short_code": "string",
          "original_url": "string",
          "total_clicks": "integer",
          "is_expired": "boolean",
          "expires_at": "string or null",
          "recent_clicks": "array"
        }
      },
      {
        "name": "resolve_url",
        "description": "Safely inspect the destination of a short code without incrementing click counts or triggering redirection",
        "parameters": {
          "short_code": { "type": "string", "description": "6-character short code", "required": true }
        },
        "returns": {
          "short_code": "string",
          "original_url": "string",
          "is_expired": "boolean",
          "expires_at": "string or null"
        }
      }
    ],
    "resources": [
      {
        "uri": "short://recent-urls",
        "name": "Recent Shortened URLs",
        "description": "Returns the latest 10 shortened URLs created in the database with click counters",
        "mimeType": "application/json"
      }
    ]
  }
}
